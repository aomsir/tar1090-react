{
  "name": "tar1090-react",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "vendor-db": "bash scripts/vendor-db.sh",
    "prebuild": "bash scripts/vendor-db.sh",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "token:password": "node scripts/token.mjs set-password",
    "token:create": "node scripts/token.mjs create",
    "token:list": "node scripts/token.mjs list",
    "token:revoke": "node scripts/token.mjs revoke",
    "token:gc": "node scripts/token.mjs gc"
  },
  "dependencies": {
    "@heroui/react": "^3.2.0",
    "@heroui/styles": "^3.2.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.20.0",
    "ol": "^10.9.0",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17.0.8",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.1",
    "vaul": "^1.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
